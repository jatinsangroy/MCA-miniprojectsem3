# ── Groq (Recommended — Fast & Free tier available) ──────────────────────
# Get your key at: https://console.groq.com/
GROQ_API_KEY=gsk_your_groq_api_key_here

# Optional: override the default Groq model
GROQ_MODEL=qwen/qwen3.8-27b

# ── OpenAI (Alternative — used if GROQ_API_KEY is not set) ───────────────
# OPENAI_API_KEY=sk_your_openai_api_key_here
# OPENAI_MODEL=gpt-4o

# ── CrewAI (disable anonymous telemetry) ─────────────────────────────────
CREWAI_DISABLE_TELEMETRY=true

# ── LiteLLM (disable prompt caching — required for Groq) ─────────────────
LITELLM_DISABLE_PROMPT_CACHING=true
