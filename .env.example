# ── OpenAI ─────────────────────────────────────────────────────────────────
# Required: your OpenAI API key
OPENAI_API_KEY=your_groq_api_key_here

# Optional: override the default model (gpt-4o is recommended)
OPENAI_MODEL=gpt-4o

# ── CrewAI telemetry (set to false to disable anonymous usage stats) ────────
CREWAI_DISABLE_TELEMETRY=true
